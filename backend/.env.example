# ============================================================
# Variables de entorno — copia este archivo a .env y rellena
# ============================================================

# --- JWT ---
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de datos ---
DATABASE_URL=sqlite:///./app.db

# --- Usuario administrador inicial ---
# Si estas variables están definidas, se crea el admin al arrancar la app
# Si el usuario ya existe, se ignora
FIRST_ADMIN_EMAIL=admin@financialhub.es
FIRST_ADMIN_PASSWORD=AdminPassword123!
FIRST_ADMIN_USERNAME=admin
